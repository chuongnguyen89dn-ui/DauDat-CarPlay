#!/bin/sh
# Remove the legacy Fullscreen427 helper that was injected into the repackaged
# DuoDash 1.1.3+fullscreen1 DEB.  It globally hooks CarPlay UIView/UIWindow
# geometry and is not part of DuoDash.dylib's split/ratio engine.
for base in /var/jb/usr/lib/TweakInject /Library/MobileSubstrate/DynamicLibraries; do
  rm -f "$base/DuoDashUnifiedFullscreen.dylib" "$base/DuoDashUnifiedFullscreen.plist" 2>/dev/null || true
done
killall -9 CarPlay 2>/dev/null || true
killall -HUP SpringBoard 2>/dev/null || true
exit 0
